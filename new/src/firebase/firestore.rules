rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.role == 'admin' || request.auth.token.admin == true);
    }

    match /blogPosts/{docId} {
      // Anyone can read published posts; admins can read everything.
      allow read: if resource.data.status == 'published' || isAdmin();
      // Only admins can create or update posts.
      allow create, update: if isAdmin();
      // Posts are archived via update, never hard-deleted from the client.
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
